{
  "name": "joaju",
  "version": "0.1.0",
  "description": "Orquestrador declarativo local e compilador acadêmico para diagramas e gráficos científicos, com extensão para heredogramas clínicos",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "serve": "node server.js",
    "demo": "sh scripts/demo.sh",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "test:mutation": "stryker run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "express": "^4.19.2",
    "uuid": "^11.1.1"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.63.0"
  }
}
