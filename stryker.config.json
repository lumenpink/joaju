{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["clear-text", "progress"],
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test test/server.test.js"
  },
  "mutate": ["server.js", "!test/**", "!e2e/**", "!site/**", "!public/**"],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 10000
}
